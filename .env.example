# mExOms Environment Configuration Template

# Environment
ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mexoms
DB_USER=mexoms
DB_PASSWORD=mexoms123

# Redis
REDIS_HOST=localhost:6379
REDIS_PASSWORD=mexoms123

# NATS
NATS_URL=nats://localhost:4222

# Vault
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=your-vault-token

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Monitoring
PROMETHEUS_ADDR=:8081
GRAFANA_PASSWORD=admin123

# Security
TLS_ENABLED=true
TLS_CERT=/app/certs/server.crt
TLS_KEY=/app/certs/server.key

# Rate Limiting
GLOBAL_RATE_LIMIT=10000
ACCOUNT_RATE_LIMIT=100

# Strategy Engine
MAX_STRATEGIES=100
MAX_ORDERS_PER_SECOND=1000

# Exchange Configuration
BINANCE_TESTNET=false
BINANCE_SPOT_WEIGHT_LIMIT=1200
BINANCE_FUTURES_WEIGHT_LIMIT=2400

# Docker Registry
DOCKER_REGISTRY=mexoms

# Version
VERSION=1.0.0