{
  "dashboard": {
    "id": null,
    "title": "Risk Management",
    "tags": ["mexoms", "risk", "compliance"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "5s",
    "panels": [
      {
        "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
        "id": 1,
        "type": "gauge",
        "title": "Total Exposure",
        "targets": [
          {
            "expr": "sum(total_exposure_usd) / sum(account_balance_usd)",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "decimals": 1,
            "min": 0,
            "max": 10,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": 0 },
                { "color": "yellow", "value": 3 },
                { "color": "orange", "value": 5 },
                { "color": "red", "value": 8 }
              ]
            }
          }
        },
        "options": {
          "showThresholdLabels": true,
          "showThresholdMarkers": true
        }
      },
      {
        "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
        "id": 2,
        "type": "gauge",
        "title": "Daily Loss vs Limit",
        "targets": [
          {
            "expr": "min(daily_pnl) / min(daily_loss_limit)",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "decimals": 1,
            "min": -1,
            "max": 0,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": -1 },
                { "color": "orange", "value": -0.8 },
                { "color": "yellow", "value": -0.5 },
                { "color": "green", "value": -0.2 }
              ]
            }
          }
        },
        "options": {
          "showThresholdLabels": true,
          "showThresholdMarkers": true
        }
      },
      {
        "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
        "id": 3,
        "type": "stat",
        "title": "Risk Checks/sec",
        "targets": [
          {
            "expr": "sum(rate(risk_checks_total[1m]))",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "decimals": 0,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": 0 },
                { "color": "yellow", "value": 10000 },
                { "color": "red", "value": 50000 }
              ]
            }
          }
        },
        "options": {
          "graphMode": "area",
          "textMode": "auto"
        }
      },
      {
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
        "id": 4,
        "type": "timeseries",
        "title": "Position Limits",
        "targets": [
          {
            "expr": "(position_size_usd / position_limit_usd) * 100",
            "legendFormat": "{{ account }} - {{ symbol }}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "decimals": 0,
            "min": 0,
            "max": 100,
            "custom": {
              "fillOpacity": 10,
              "lineWidth": 2,
              "drawStyle": "line",
              "showPoints": "never"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": 0 },
                { "color": "yellow", "value": 80 },
                { "color": "red", "value": 95 }
              ]
            }
          }
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          }
        }
      },
      {
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
        "id": 5,
        "type": "table",
        "title": "Account Risk Metrics",
        "targets": [
          {
            "expr": "max by (account) (total_exposure_usd / account_balance_usd)",
            "format": "table",
            "instant": true,
            "refId": "A"
          },
          {
            "expr": "min by (account) (daily_pnl)",
            "format": "table",
            "instant": true,
            "refId": "B"
          },
          {
            "expr": "sum by (account) (active_positions_total)",
            "format": "table",
            "instant": true,
            "refId": "C"
          },
          {
            "expr": "max by (account) (position_concentration)",
            "format": "table",
            "instant": true,
            "refId": "D"
          }
        ],
        "transformations": [
          {
            "id": "merge",
            "options": {}
          },
          {
            "id": "organize",
            "options": {
              "excludeByName": { "Time": true },
              "renameByName": {
                "account": "Account",
                "Value #A": "Leverage",
                "Value #B": "Daily Loss",
                "Value #C": "Positions",
                "Value #D": "Concentration"
              }
            }
          }
        ],
        "fieldConfig": {
          "overrides": [
            {
              "matcher": { "id": "byName", "options": "Leverage" },
              "properties": [
                { "id": "decimals", "value": 1 },
                { "id": "unit", "value": "short" },
                { "id": "custom.displayMode", "value": "gradient-gauge" },
                { "id": "max", "value": 10 },
                { "id": "thresholds", "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": 0 },
                    { "color": "yellow", "value": 3 },
                    { "color": "red", "value": 5 }
                  ]
                }}
              ]
            },
            {
              "matcher": { "id": "byName", "options": "Daily Loss" },
              "properties": [
                { "id": "unit", "value": "currencyUSD" },
                { "id": "decimals", "value": 0 },
                { "id": "custom.displayMode", "value": "color-background" },
                { "id": "thresholds", "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "red", "value": -10000 },
                    { "color": "yellow", "value": -5000 },
                    { "color": "green", "value": 0 }
                  ]
                }}
              ]
            },
            {
              "matcher": { "id": "byName", "options": "Concentration" },
              "properties": [
                { "id": "unit", "value": "percentunit" },
                { "id": "decimals", "value": 1 },
                { "id": "custom.displayMode", "value": "gradient-gauge" },
                { "id": "max", "value": 1 },
                { "id": "thresholds", "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": 0 },
                    { "color": "yellow", "value": 0.3 },
                    { "color": "red", "value": 0.5 }
                  ]
                }}
              ]
            }
          ]
        }
      },
      {
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
        "id": 6,
        "type": "timeseries",
        "title": "Risk Events",
        "targets": [
          {
            "expr": "sum by (type) (rate(risk_events_total[5m]))",
            "legendFormat": "{{ type }}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "events/sec",
            "decimals": 2,
            "custom": {
              "fillOpacity": 50,
              "lineWidth": 2,
              "stacking": {
                "mode": "normal",
                "group": "A"
              }
            }
          }
        }
      },
      {
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
        "id": 7,
        "type": "heatmap",
        "title": "Position Correlation Matrix",
        "targets": [
          {
            "expr": "position_correlation_matrix",
            "format": "heatmap",
            "refId": "A"
          }
        ],
        "options": {
          "color": {
            "mode": "scheme",
            "scheme": "RdBu",
            "reverse": true
          },
          "cellValues": {
            "unit": "percentunit",
            "decimals": 2
          }
        }
      },
      {
        "gridPos": { "h": 6, "w": 24, "x": 0, "y": 22 },
        "id": 8,
        "type": "alertlist",
        "title": "Active Risk Alerts",
        "options": {
          "maxItems": 10,
          "sortOrder": 1,
          "dashboardAlerts": false,
          "alertName": "",
          "dashboardTitle": "",
          "tags": ["risk", "mexoms"],
          "stateFilter": {
            "firing": true,
            "pending": true
          }
        }
      }
    ]
  }
}